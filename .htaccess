RewriteEngine On
# Desativar a listagem de pastas (boa prática de segurança)
Options -Indexes

## ROUTER WWW Redirect (Opcional - Remova o # do início para ativar em produção)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

## ROUTER HTTPS Redirect (Opcional - Remova o # do início para ativar em produção)
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# CONFIGURAÇÃO DE URL AMIGÁVEL DO BRAMUS/ROUTER
# Se o arquivo ou pasta física não existirem no disco, envia tudo para o index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]
